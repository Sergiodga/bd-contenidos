erdiagram ModeloEstudioVideojuegos
notation=crowsfoot

entity Desarrollador {
    dni key
    cuenta_bancaria unique
    sueldo
    especialidad
    nombre
    apellido_1
    apellido_2
}

entity Equipo {
    codigo key
    nombre unique
    sedes
}

entity Videojuego{
    codigo key
    titulo unique
    argumento
}

entity Nivel{
    numero key
    nombre
    dificultad
    duracion_estimada
}

relationship pertenece_a {
    Desarrollador [0..N]-> Equipo [1..1]
}

relationship lidera {
    Desarrollador [1..1]-> Equipo [0..1]
    fecha_inicio_lider
}