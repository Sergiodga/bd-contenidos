erdiagram EjemplosNotacionBigER
notation=crowsfoot

entity Estudiante {
    numero_expediente key
    dni unique
    nombre
    apellido_1
    apellido_2
}

entity Coche {
    vin key
    matricula unique
    modelo
}


weak entity Contacto_Emergencia {
    nombre partial-key
    telefono
    parentesco
}

weak relationship tiene_contacto {
    Contacto_Emergencia[1..N] -> Estudiante[1..1]
}
